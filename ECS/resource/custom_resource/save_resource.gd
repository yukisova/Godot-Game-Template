## @editing: Sora [br]
## @describe: 游戏存档数据文件 - 统一管理所有需要持久化的游戏数据
##
## 该资源类定义了游戏存档的完整数据结构，包含：
## - 玩家角色的状态和进度信息
## - 地图中静态实体的状态数据
## - 地图缓存和层级信息
## - 全局黑板的共享数据
##
## 数据分类：
## - 玩家数据：位置、属性、背包、装备等
## - 静态实体：NPC对话状态、机关状态、收集品等
## - 地图数据：当前关卡、解锁状态、传送点等
## - 系统数据：设置、成就、统计信息等
##
## 存储策略：
## - 使用JSON格式进行序列化
## - 支持增量保存和完整保存
## - 提供数据验证和版本兼容性
class_name SavedDataFile
extends Resource

#region 玩家数据

## 玩家信息字典
## 存储玩家角色的所有状态数据
## 包含：位置、属性、等级、经验等
## 由SMainController系统负责读写
@export var player_info = {}

#endregion

#region 实体数据

## 静态实体数据字典
## 存储地图中预设实体的状态信息
## 
## 实体分类：
## - 静态实体：地图中预设的NPC、机关、收集品等
## - 动态实体：运行时生成的敌人、子弹、特效等（不保存）
##
## 存储策略：
## - 通过场景路径识别实体类型
## - 仅保存状态变化的实体
## - 支持实体的增量更新
@export var static_entity = {}

#endregion

#region 地图数据

## 地图缓存字典
## 存储地图的临时状态和缓存数据
## 包含：敌人刷新状态、环境变化、临时对象等
@export var map_cache = {}

## 地图信息字典
## 存储地图的层级结构和配置数据
## 包含：关卡进度、解锁状态、传送点信息等
@export var map_info = {}

#endregion

#region 系统数据

## 黑板信息字典
## 存储全局共享的系统数据
## 包含：任务状态、全局变量、剧情标记等
## 由SBlackboard系统负责读写
@export var blackboard_info = {}

#endregion
